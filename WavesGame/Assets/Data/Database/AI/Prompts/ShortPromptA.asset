%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e89ac9b32d19465c8a6cd64ced4e709b, type: 3}
  m_Name: ShortPromptA
  m_EditorClassIdentifier: Assembly-CSharp::Actors.AI.LlmAI.LlmPromptSo
  prompt: "WavesST. You = @faction@. Enemies = @enemy_factions@.\nYour ship @self_status@
    at (@self_x@,@self_y@).\nEnemies: @grid_overview_enemies@\nWaves: @grid_overview_waves@\n\n\u2694\uFE0F
    Attack is valid ONLY at exactly 2 tiles away.\nOnly enemy ships may be attacked.\n\n\u2694\uFE0F
    ATTACK NOW (no move needed):@current_attack_positions@\n\nMOVE + ATTACK PAIRS
    (move to X, attack Y):\n@attack_enabling_tiles@\n\n\u2713 SAFE MOVE TILES:@safe_movement_positions@\n\n\u274C
    DO NOT MOVE HERE (waves or blocked):@blocked_movement_positions@\n\nRULES\n1.
    If ATTACK NOW is not empty: attack the listed enemy, do not move.\n2. Else if
    MOVE + ATTACK PAIRS is not empty: pick one pair.\n3. Else: move to a SAFE tile
    closer to nearest enemy, attack = [-1,-1].\n4. Never move to a tile not on the
    SAFE list.\n5. After attacking, if you can still move, move away to prevent being
    attacked back.\n\nReply JSON only:\n{\"reasoning\": \"brief\", \"movement\":
    [x1, y1], \"attack\": [x2, y2], \"move_after_attack\": [x3, y3]}"
  includeEmptySpaces: 0
